# Contract Playbook Builder - Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env
#
# NOTE: You can also configure these settings from the web UI at startup.

# =============================================================================
# AI PROVIDER SETTINGS (Required - choose one)
# =============================================================================

# Which provider to use: anthropic, openai, or google
# AI_PROVIDER=anthropic

# Anthropic Claude API (Recommended)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini API
# Get your key at: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-google-api-key-here

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Server port (default: 3005)
# PORT=3005

# AI Model selection (defaults shown)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o
# GOOGLE_MODEL=gemini-2.5-pro

# Maximum file upload size in MB (default: 50)
# MAX_FILE_SIZE=50

# Enable debug mode (default: 0)
# FLASK_DEBUG=0
